# ---------------------------------------------------------------------------
# SyncRoom — Example environment variables
# Copy to .env and fill in values. Do not commit .env.
# ---------------------------------------------------------------------------

# ----- Client (used at build time for Vite)
VITE_API_URL=http://localhost:3001
# Production: your Render backend URL, e.g. https://syncroom-api.onrender.com

# ----- Server
PORT=3001
NODE_ENV=development
# Allowed CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173
# Production: https://your-app.vercel.app
